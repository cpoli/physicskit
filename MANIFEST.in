# The sdist carries the full test suite (each subpackage's tests/) for
# downstream packagers; the wheel does not, via exclude-package-data in
# pyproject.toml.
graft physicskit
prune physicskit/rmt/tests/.physicskit.rmt_test_cache
prune physicskit/rmt/tests/.rmtkit_test_cache
global-exclude __pycache__ *.py[cod] *.nbi *.nbc .DS_Store
